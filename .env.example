# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# docker compose automatically reads ".env". The real ".env" is gitignored.

# SQL Server "sa" password (must meet complexity: 8+ chars, upper, lower, digit/symbol).
DB_PASSWORD=Your_Strong_Passw0rd!

# JWT signing key for the API (use a long random string, 32+ characters).
JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Seeded admin login for the application.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# ExchangeRate-API key (USD->ZAR). Leave blank to skip live FX (currency endpoints will return 503).
FX_API_KEY=
