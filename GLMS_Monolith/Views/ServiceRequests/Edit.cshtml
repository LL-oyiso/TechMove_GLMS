@model GLMS_Monolith.Models.ServiceRequest
@using GLMS_Monolith.Models.Enums

@{
    ViewData["Title"] = "Edit Service Request";
}

<div class="page-header">
    <div>
        <h1>Edit Service Request</h1>
        <p class="text-muted mb-0">Update request details and status.</p>
    </div>
</div>

<div class="detail-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="ContractId" class="form-label fw-semibold"></label>
            <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId"></select>
            <span asp-validation-for="ContractId" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="CostUsd" class="form-label fw-semibold"></label>
            <input asp-for="CostUsd" class="form-control" />
            <span asp-validation-for="CostUsd" class="text-danger small"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Status" class="form-label fw-semibold"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()"></select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>

        <div class="form-actions">
            <input type="submit" value="Save Changes" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}