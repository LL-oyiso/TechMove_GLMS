@model GLMS_Monolith.Models.ServiceRequest
@using GLMS_Monolith.Models.Enums

@{
    ViewData["Title"] = "Service Request Details";
}

<div class="page-header">
    <div>
        <h1>Service Request Details</h1>
        <p class="text-muted mb-0">Full breakdown of cost, contract, and status.</p>
    </div>
</div>

<div class="detail-card">
    <dl class="detail-grid">
        <div class="detail-row">
            <dt>Contract</dt>
            <dd>#@Model.ContractId — @(Model.Contract?.Client?.Name ?? "-")</dd>
        </div>
        <div class="detail-row">
            <dt>Description</dt>
            <dd>@Model.Description</dd>
        </div>
        <div class="detail-row">
            <dt>Cost (USD)</dt>
            <dd>$@Model.CostUsd.ToString("N2")</dd>
        </div>
        <div class="detail-row">
            <dt>Cost (ZAR)</dt>
            <dd>R @Model.CostZar.ToString("N2")</dd>
        </div>
        <div class="detail-row">
            <dt>Exchange Rate Used</dt>
            <dd>@Model.ExchangeRateUsed.ToString("N6")</dd>
        </div>
        <div class="detail-row">
            <dt>Status</dt>
            <dd><span class="status-pill status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd>
        </div>
        <div class="detail-row">
            <dt>Created At</dt>
            <dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </div>
    </dl>

    <div class="form-actions mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>
