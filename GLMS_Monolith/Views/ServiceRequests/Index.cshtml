@model IEnumerable<GLMS_Monolith.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="page-header">
    <div>
        <h1>Service Requests</h1>
        <p class="text-muted mb-0">Track request costs, FX conversions, and current workflow status.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Request</a>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Contract</th>
            <th>Client</th>
            <th>Description</th>
            <th>USD</th>
            <th>ZAR</th>
            <th>Rate</th>
            <th>Status</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                #@item.ContractId
            </td>
            <td>
                @(item.Contract?.Client?.Name ?? "-")
            </td>
            <td>
                @item.Description
            </td>
            <td>
                @item.CostUsd.ToString("N2")
            </td>
            <td>
                @item.CostZar.ToString("N2")
            </td>
            <td>
                @item.ExchangeRateUsed.ToString("N6")
            </td>
            <td>
                <span class="status-pill status-@item.Status.ToString().ToLowerInvariant()">@StatusHelper.Label(item.Status)</span>
            </td>
            <td>
                @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </td>
            <td>
                <div class="actions-inline">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
