@model GLMS_Monolith.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<div class="page-header">
    <div>
        <h1>Delete Service Request</h1>
        <p class="text-muted mb-0">This action cannot be undone.</p>
    </div>
</div>

<div class="detail-card">
    <p class="text-danger fw-semibold mb-3">Are you sure you want to delete this service request?</p>

    <dl class="detail-grid mb-3">
        <div class="detail-row">
            <dt>Contract</dt>
            <dd>#@Model.ContractId — @(Model.Contract?.Client?.Name ?? "-")</dd>
        </div>
        <div class="detail-row">
            <dt>Description</dt>
            <dd>@Model.Description</dd>
        </div>
        <div class="detail-row">
            <dt>Cost (USD)</dt>
            <dd>$@Model.CostUsd.ToString("N2")</dd>
        </div>
        <div class="detail-row">
            <dt>Cost (ZAR)</dt>
            <dd>R @Model.CostZar.ToString("N2")</dd>
        </div>
        <div class="detail-row">
            <dt>Status</dt>
            <dd><span class="status-pill status-@Model.Status.ToString().ToLowerInvariant()">@StatusHelper.Label(Model.Status)</span></dd>
        </div>
        <div class="detail-row">
            <dt>Created</dt>
            <dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <input type="submit" value="Yes, Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
