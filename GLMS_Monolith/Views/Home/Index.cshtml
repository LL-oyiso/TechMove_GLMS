@using GLMS_Monolith.Models
@using GLMS_Monolith.Models.Enums

@{
    ViewData["Title"] = "Dashboard";
    var attentionContracts = ViewBag.AttentionContracts as List<Contract> ?? new List<Contract>();
    var recentRequests = ViewBag.RecentRequests as List<ServiceRequest> ?? new List<ServiceRequest>();
}

<section class="dash-hero">
    <div class="dash-hero-content">
        <div>
            <h1 class="dash-hero-title">TechMove GLMS</h1>
            <p class="dash-hero-subtitle">Operations Command Center</p>
        </div>
        <div class="dash-hero-actions">
            <a asp-controller="Contracts" asp-action="Create" class="btn btn-light btn-hero">+ Create Contract</a>
            <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-outline-light btn-hero">+ Create Service Request</a>
        </div>
    </div>
</section>

<div class="kpi-row">
    <div class="kpi-card kpi-active">
        <div class="kpi-label">Active Contracts</div>
        <div class="kpi-value">@ViewBag.ActiveContracts</div>
    </div>
    <div class="kpi-card kpi-hold">
        <div class="kpi-label">On-Hold Contracts</div>
        <div class="kpi-value">@ViewBag.OnHoldContracts</div>
    </div>
    <div class="kpi-card kpi-today">
        <div class="kpi-label">Requests Today</div>
        <div class="kpi-value">@ViewBag.RequestsToday</div>
    </div>
    <div class="kpi-card kpi-total">
        <div class="kpi-label">Total Requests</div>
        <div class="kpi-value">@ViewBag.TotalRequests</div>
    </div>
</div>

<div class="dash-panels">
    <div class="dash-panel">
        <div class="dash-panel-header">
            <h3>Contracts Requiring Attention</h3>
            <a asp-controller="Contracts" asp-action="Index" class="panel-viewall">View all</a>
        </div>
        @if (!attentionContracts.Any())
        {
            <p class="text-muted small mt-2">No contracts require attention.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Client</th>
                        <th>Service Level</th>
                        <th>Status</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in attentionContracts)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@(c.Client?.Name ?? "-")</td>
                            <td>@c.ServiceLevel</td>
                            <td><span class="status-pill status-@c.Status.ToString().ToLowerInvariant()">@StatusHelper.Label(c.Status)</span></td>
                            <td>@c.EndDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="dash-panel">
        <div class="dash-panel-header">
            <h3>Recent Service Requests</h3>
            <a asp-controller="ServiceRequests" asp-action="Index" class="panel-viewall">View all</a>
        </div>
        @if (!recentRequests.Any())
        {
            <p class="text-muted small mt-2">No service requests found.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Client</th>
                        <th>Description</th>
                        <th>USD</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in recentRequests)
                    {
                        <tr>
                            <td>@r.Id</td>
                            <td>@(r.Contract?.Client?.Name ?? "-")</td>
                            <td>@(r.Description.Length > 40 ? r.Description[..40] + "…" : r.Description)</td>
                            <td>@r.CostUsd.ToString("N2")</td>
                            <td><span class="status-pill status-@r.Status.ToString().ToLowerInvariant()">@StatusHelper.Label(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="dash-quicklinks">
    <a asp-controller="Clients" asp-action="Index" class="quick-link-card">
        <h3>Clients</h3>
        <p>Manage customer profiles and regional contacts.</p>
    </a>
    <a asp-controller="Contracts" asp-action="Index" class="quick-link-card">
        <h3>Contracts</h3>
        <p>Track status, service levels, and signed PDFs.</p>
    </a>
    <a asp-controller="ServiceRequests" asp-action="Index" class="quick-link-card">
        <h3>Service Requests</h3>
        <p>Live USD to ZAR conversion and workflow tracking.</p>
    </a>
</div>
