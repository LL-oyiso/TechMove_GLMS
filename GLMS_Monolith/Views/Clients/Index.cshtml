@model IEnumerable<GLMS.Shared.Dtos.ClientDto>

@{
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div>
        <h1>Clients</h1>
        <p class="text-muted mb-0">Manage customer profiles and regional contact information.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Client</a>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Contact Details</th>
            <th>Region</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.ContactDetails</td>
            <td>@item.Region</td>
            <td>
                <div class="actions-inline">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
