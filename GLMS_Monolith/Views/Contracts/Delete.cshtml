@model GLMS_Monolith.Models.Contract

@{
    ViewData["Title"] = "Delete Contract";
}

<div class="page-header">
    <div>
        <h1>Delete Contract</h1>
        <p class="text-muted mb-0">This action cannot be undone.</p>
    </div>
</div>

<div class="detail-card">
    <p class="text-danger fw-semibold mb-3">Are you sure you want to delete this contract?</p>

    <dl class="detail-grid mb-3">
        <div class="detail-row">
            <dt>Client</dt>
            <dd>@(Model.Client?.Name ?? $"Client #{Model.ClientId}")</dd>
        </div>
        <div class="detail-row">
            <dt>Start Date</dt>
            <dd>@Model.StartDate.ToString("yyyy-MM-dd")</dd>
        </div>
        <div class="detail-row">
            <dt>End Date</dt>
            <dd>@Model.EndDate.ToString("yyyy-MM-dd")</dd>
        </div>
        <div class="detail-row">
            <dt>Status</dt>
            <dd><span class="status-pill status-@Model.Status.ToString().ToLowerInvariant()">@StatusHelper.Label(Model.Status)</span></dd>
        </div>
        <div class="detail-row">
            <dt>Service Level</dt>
            <dd>@Model.ServiceLevel</dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <input type="submit" value="Yes, Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
