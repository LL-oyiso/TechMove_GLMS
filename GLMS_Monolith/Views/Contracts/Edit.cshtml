@model GLMS_Monolith.Models.Contract
@using GLMS_Monolith.Models.Enums

@{
    ViewData["Title"] = "Edit Contract";
}

<h1>Edit Contract</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-2">
                <label asp-for="ClientId" class="control-label"></label>
                <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientId"></select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<ContractStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="ServiceLevel" class="control-label"></label>
                <input asp-for="ServiceLevel" class="form-control" />
                <span asp-validation-for="ServiceLevel" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Replace Signed Agreement (PDF)</label>
                <input type="file" name="signedAgreementFile" class="form-control" accept=".pdf,application/pdf" />
                <span class="text-danger">@Html.ValidationMessage("signedAgreementFile")</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SignedAgreementStoredPath))
            {
                <div class="form-group mb-3">
                    <p>
                        Current file:
                        <a asp-action="DownloadAgreement" asp-route-id="@Model.Id">@Model.SignedAgreementFileName</a>
                    </p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="removeExistingFile" value="true" id="removeExistingFile" />
                        <label class="form-check-label" for="removeExistingFile">
                            Remove current file
                        </label>
                    </div>
                </div>
            }

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-link">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}