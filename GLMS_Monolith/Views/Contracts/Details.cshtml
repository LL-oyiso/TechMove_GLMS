@model GLMS.Shared.Dtos.ContractDto

@{
    ViewData["Title"] = "Contract Details";
}

<div class="page-header">
    <div>
        <h1>Contract Details</h1>
        <p class="text-muted mb-0">Full contract record and signed agreement.</p>
    </div>
</div>

<div class="detail-card">
    <dl class="detail-grid">
        <div class="detail-row">
            <dt>Client</dt>
            <dd>@(Model.ClientName ?? $"Client #{Model.ClientId}")</dd>
        </div>
        <div class="detail-row">
            <dt>Start Date</dt>
            <dd>@Model.StartDate.ToString("yyyy-MM-dd")</dd>
        </div>
        <div class="detail-row">
            <dt>End Date</dt>
            <dd>@Model.EndDate.ToString("yyyy-MM-dd")</dd>
        </div>
        <div class="detail-row">
            <dt>Status</dt>
            <dd><span class="status-pill status-@Model.Status.ToString().ToLowerInvariant()">@StatusHelper.Label(Model.Status)</span></dd>
        </div>
        <div class="detail-row">
            <dt>Service Level</dt>
            <dd>@Model.ServiceLevel</dd>
        </div>
        <div class="detail-row">
            <dt>Signed Agreement</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(Model.SignedAgreementStoredPath))
                {
                    <a asp-action="DownloadAgreement" asp-route-id="@Model.Id">@Model.SignedAgreementFileName</a>
                    <div class="text-muted small mt-1">Uploaded: @Model.SignedAgreementUploadedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                }
                else
                {
                    <span class="text-muted">No file uploaded.</span>
                }
            </dd>
        </div>
    </dl>

    <div class="form-actions mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>
