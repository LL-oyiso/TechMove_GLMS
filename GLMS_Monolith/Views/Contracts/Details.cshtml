@model GLMS_Monolith.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<h1>Contract Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Client</dt>
        <dd class="col-sm-9">@(Model.Client?.Name ?? $"Client #{Model.ClientId}")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartDate)</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndDate)</dt>
        <dd class="col-sm-9">@Model.EndDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ServiceLevel)</dt>
        <dd class="col-sm-9">@Model.ServiceLevel</dd>

        <dt class="col-sm-3">Signed Agreement</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrWhiteSpace(Model.SignedAgreementStoredPath))
            {
                <a asp-action="DownloadAgreement" asp-route-id="@Model.Id">@Model.SignedAgreementFileName</a>
                <div class="text-muted small">Uploaded: @Model.SignedAgreementUploadedAt?.ToString("u")</div>
            }
            else
            {
                <span class="text-muted">No file uploaded.</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>