@model GLMS_Monolith.Models.ApiErrorViewModel

@{
    ViewData["Title"] = "Service Error";
}

<div class="detail-card">
    <h1 class="text-danger">Something went wrong</h1>
    <p class="text-muted">The application could not complete your request because the API returned an error.</p>

    <dl class="detail-grid mb-3">
        <div class="detail-row">
            <dt>Status code</dt>
            <dd>@Model.StatusCode</dd>
        </div>
        <div class="detail-row">
            <dt>Details</dt>
            <dd>@Model.Message</dd>
        </div>
    </dl>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
</div>
